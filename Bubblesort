def bubble_sort(arr):
  n = len(arr)

  for i in range(n):
    isSwapped = False

    for j in range(n - 1 - i):
      if arr[j] > arr[j + 1]:
        arr[j], arr[j + 1] = arr[j + 1], arr[j]
        isSwapped = True

    if not isSwapped:
      break

if __name__ == '__main__':
  arr = [5, 4, 3, 2, 1]
  bubble_sort(arr)
  print(arr)
